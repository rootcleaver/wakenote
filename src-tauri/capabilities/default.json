{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Allows WakeNote windows to use required core APIs and open file dialogs.",
  "windows": ["main", "overlay", "quick-audio", "input-notice"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "notification:default"
  ]
}
